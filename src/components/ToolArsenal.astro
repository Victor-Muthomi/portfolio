---
// src/components/ToolArsenal.astro

const categories = [
  {
    name: 'Reconnaissance',
    icon: '🔍',
    tools: ['Shodan', 'Maltego', 'Recon-ng', 'theHarvester', 'Amass']
  },
  {
    name: 'Network Analysis',
    icon: '🌐',
    tools: ['Nmap', 'Wireshark', 'Netcat']
  },
  {
    name: 'Web Security',
    icon: '🛡️',
    tools: ['Burp Suite', 'OWASP ZAP', 'SQLMap', 'Gobuster']
  },
  {
    name: 'Exploitation',
    icon: '⚡',
    tools: ['Metasploit', 'Hydra', 'Responder']
  },
  {
    name: 'Active Directory',
    icon: '🔑',
    tools: ['BloodHound', 'SharpHound', 'NetExec']
  },
  {
    name: 'Reporting',
    icon: '📄',
    tools: ['Markdown', 'Dradis', 'CherryTree']
  }
];
---

<section id="tools" class="py-32 bg-background relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-24 reveal">
      <div class="tech-label">TECHNICAL_STACK</div>
      <h2 class="text-4xl md:text-5xl font-black mb-6">Technical <span class="text-accent underline decoration-accent/20 underline-offset-8">Tool Arsenal.</span></h2>
      <p class="text-muted text-lg max-w-2xl mx-auto leading-relaxed">
        A curated collection of enterprise and open-source security tools utilized for comprehensive threat analysis and offensive operations.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((category, index) => (
        <div class="reveal group" style={`transition-delay: ${index * 100}ms;`}>
          <div class="h-full glass-card p-8 rounded-2xl border-border hover:border-accent/40 hover:bg-surface/50 transition-all duration-500 relative overflow-hidden">
            <!-- Subtle category icon background -->
            <div class="absolute -top-6 -right-6 text-7xl opacity-[0.03] group-hover:opacity-[0.07] transition-opacity">
              {category.icon}
            </div>
            
            <div class="flex items-center gap-4 mb-8">
              <div class="w-10 h-10 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
                {category.icon}
              </div>
              <h3 class="text-xl font-bold tracking-tight">{category.name}</h3>
            </div>
            
            <div class="flex flex-wrap gap-2">
              {category.tools.map((tool) => (
                <div class="px-3 py-1.5 rounded-lg bg-surface border border-border group/tool hover:border-accent/40 hover:bg-accent/5 transition-all duration-300">
                  <span class="text-xs font-mono font-medium text-muted group-hover/tool:text-accent transition-colors">
                    {tool}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
  }
</style>
