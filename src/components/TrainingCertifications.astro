---
// src/components/TrainingCertifications.astro

const timelineItems = [
  {
    title: "Google Cybersecurity Certificate",
    platform: "Coursera / Google",
    date: "2024",
    status: "Completed",
    icon: "🎓",
    description: "Foundational training covering network security, Linux, Python, SQL, and incident response. Focus on threat detection and professional security reporting.",
    skills: ["SIEM Tools", "Network Security", "Incident Response", "NIST Framework"]
  },
  {
    title: "TryHackMe Learning Paths",
    platform: "TryHackMe",
    date: "2024 - Present",
    status: "Active",
    icon: "🏗️",
    description: "Completing hands-on offensive and defensive learning paths with a focus on practical exploitation and vulnerability assessment.",
    skills: ["Jr. Pen Tester", "Pre-Security", "SOC Level 1", "PrivEsc"]
  },
  {
    title: "Hack The Box Labs",
    platform: "Hack The Box",
    date: "2024 - Present",
    status: "Active",
    icon: "🧊",
    description: "Engagement with competitive laboratory environments involving real-world machine exploitation (Linux/Windows) and Active Directory assessments.",
    skills: ["Web Exploitation", "AD Pentesting", "Reverse Engineering", "Root Access"]
  },
  {
    title: "Security Research Projects",
    platform: "Independent / GitHub",
    date: "Ongoing",
    status: "Active",
    icon: "🔬",
    description: "Deep-dive analysis of emerging vulnerabilities, local lab setup, and developing custom security automation scripts in Python.",
    skills: ["Vulnerability Research", "Exploit Dev", "Env Hardening", "Automation"]
  },
  {
    title: "Future Certifications",
    platform: "Offensive Security / eLearningSecurity",
    date: "Planned 2025",
    status: "Planned",
    icon: "🚀",
    description: "Targeting advanced industry-standard certifications to validate offensive security proficiency and professional methodologies.",
    skills: ["eJPT", "OSCP", "CRTP"]
  }
];
---

<section id="training" class="py-32 bg-background relative overflow-hidden">
  <!-- Subtle Background Assets -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-accent/5 blur-[120px] rounded-full"></div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-20 reveal">
      <div class="tech-label">TRAINING_MATURITY</div>
      <h2 class="text-4xl md:text-5xl font-black mb-6">Training & <span class="text-accent underline decoration-accent/20 underline-offset-8">Certifications.</span></h2>
      <p class="text-muted text-lg max-w-2xl mx-auto leading-relaxed">
        Continuous learning and hands-on laboratory experience drive technical excellence in a rapidly evolving security landscape.
      </p>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative">
      <!-- Vertical Center Line (Desktop) -->
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-accent/5 via-accent/30 to-accent/5 -translate-x-1/2 z-0"></div>
      
      <!-- Vertical Side Line (Mobile) -->
      <div class="md:hidden absolute left-4 top-0 bottom-0 w-px bg-gradient-to-b from-accent/5 via-accent/30 to-accent/5 z-0"></div>

      <div class="space-y-12 md:space-y-24">
        {timelineItems.map((item, index) => (
          <div class={`reveal relative flex flex-col md:flex-row items-start md:items-center ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`} style={`transition-delay: ${index * 150}ms;`}>
            
            <!-- Timeline Node (Dot) -->
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-background border-2 border-accent/40 flex items-center justify-center -translate-x-1/2 z-10 shadow-[0_0_15px_rgba(0,229,255,0.2)]">
               <div class="w-2 h-2 rounded-full bg-accent animate-pulse"></div>
            </div>

            <!-- Content Area -->
            <div class="w-full md:w-[45%] ml-12 md:ml-0 group">
              <div class="glass-card p-8 rounded-2xl border-border hover:border-accent/40 hover:bg-surface/80 transition-all duration-500 relative overflow-hidden">
                <!-- Status Badge -->
                <div class="absolute top-4 right-4 text-[8px] font-mono font-bold px-2 py-1 rounded border border-border bg-background/50 flex items-center gap-1.5 uppercase tracking-widest">
                  <span class={`w-1.5 h-1.5 rounded-full ${item.status === 'Completed' ? 'bg-green-500' : item.status === 'Active' ? 'bg-amber-500 animate-pulse' : 'bg-accent/40'}`}></span>
                  {item.status}
                </div>

                <div class="relative z-10">
                  <div class="flex items-center gap-3 mb-4">
                    <span class="text-3xl group-hover:scale-125 transition-transform duration-300">{item.icon}</span>
                    <div>
                      <h3 class="text-xl font-bold group-hover:text-accent transition-colors">{item.title}</h3>
                      <p class="text-xs text-accent/60 font-mono font-medium">{item.platform} • {item.date}</p>
                    </div>
                  </div>
                  
                  <p class="text-sm text-muted leading-relaxed mb-6">
                    {item.description}
                  </p>

                  <div class="flex flex-wrap gap-2">
                    {item.skills.map((skill) => (
                      <span class="text-[9px] font-mono px-2 py-1 rounded bg-accent/5 border border-accent/10 text-accent/80 group-hover:border-accent/30 transition-colors">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Subtle Decorative Gradient -->
                <div class="absolute -bottom-12 -right-12 w-24 h-24 bg-accent/5 blur-2xl group-hover:bg-accent/10 transition-colors z-0"></div>
              </div>
            </div>

            <!-- Date Label (Desktop Only - Optional contrast) -->
             <div class="hidden md:flex flex-1 justify-center pointer-events-none">
                <span class="text-4xl font-black text-accent/5 select-none">{item.date}</span>
             </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
  }
</style>
