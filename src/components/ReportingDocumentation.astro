---
// src/components/ReportingDocumentation.astro

const reportSections = [
  {
    title: "Executive Summary",
    icon: "📋",
    description: "High-level overview of security posture, critical risks, and business impact for stakeholders.",
    details: "Focuses on strategic risk management and overall security health."
  },
  {
    title: "Scope & Objectives",
    icon: "🎯",
    description: "Defined boundaries of the assessment, including IP ranges, domains, and specific test constraints.",
    details: "Ensures transparent engagement parameters and legal compliance."
  },
  {
    title: "Methodology",
    icon: "⚙️",
    description: "Step-by-step description of the testing framework (OSSTMM, OWASP, PTES) used during the engagement.",
    details: "Provides a repeatable and industry-standard approach to testing."
  },
  {
    title: "Technical Findings",
    icon: "🔍",
    description: "Detailed breakdown of vulnerabilities, proof-of-concepts, and exploit technical analysis.",
    details: "Includes request/response pairs and step-by-step reproduction."
  },
  {
    title: "Risk Ratings",
    icon: "📊",
    description: "Standardized CVSS v3.1 scoring and qualitative impact/likelihood assessment for each finding.",
    details: "Prioritizes vulnerabilities based on real-world business risk."
  },
  {
    title: "Remediation Plan",
    icon: "🛠️",
    description: "Actionable, prioritized recommendations for fixing identified flaws and hardening the environment.",
    details: "Short-term fixes vs. long-term strategic security improvements."
  },
  {
    title: "Appendices",
    icon: "📁",
    description: "Raw tool outputs, full scan results, and supplemental data supporting the main report findings.",
    details: "Provides the technical evidence required for deep-dive analysis."
  }
];
---

<section id="reporting" class="py-32 bg-surface/10 relative overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-accent/5 to-transparent pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="mb-20 reveal">
      <div class="tech-label">PRO_DELIVERABLES</div>
      <h2 class="text-4xl md:text-5xl font-black mb-6">Reporting & <span class="text-accent">Documentation.</span></h2>
      <p class="text-muted text-lg max-w-2xl leading-relaxed">
        Delivering comprehensive, actionable security intelligence through structured, consulting-grade reports tailored for both technical teams and executive leadership.
      </p>
    </div>

    <div class="grid lg:grid-cols-12 gap-16">
      <!-- Left: Column for Preview Cards -->
      <div class="lg:col-span-7 space-y-4">
        {reportSections.map((section, index) => (
          <div class="reveal group" style={`transition-delay: ${index * 100}ms;`}>
            <div class="glass-card p-6 rounded-xl border-border hover:border-accent/40 hover:bg-surface/80 transition-all duration-300 flex gap-6 items-start">
              <div class="w-12 h-12 rounded-lg bg-background border border-border flex items-center justify-center text-2xl shrink-0 group-hover:scale-110 group-hover:border-accent/40 group-hover:shadow-[0_0_15px_rgba(0,229,255,0.2)] transition-all">
                {section.icon}
              </div>
              <div>
                <div class="flex items-center gap-3 mb-2">
                  <h3 class="text-lg font-bold group-hover:text-accent transition-colors">{section.title}</h3>
                  <span class="text-[9px] font-mono text-accent/40 font-bold uppercase tracking-widest">Section_0{index + 1}</span>
                </div>
                <p class="text-sm text-muted leading-relaxed mb-2">{section.description}</p>
                <p class="text-[10px] font-mono text-accent/60 opacity-0 group-hover:opacity-100 transition-opacity uppercase tracking-tighter">
                  {section.details}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Right: PDF Preview & Download Area -->
      <div class="lg:col-span-5 sticky top-32 h-fit reveal" style="transition-delay: 500ms;">
        <div class="glass-card p-8 rounded-[2rem] border-accent/20 relative overflow-hidden group">
          <!-- Background Glow -->
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-accent/10 blur-3xl group-hover:bg-accent/20 transition-colors"></div>
          
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-8">
              <div>
                <p class="text-[10px] font-mono text-accent/60 uppercase tracking-[0.2em] mb-1">Standard_Deliverable</p>
                <h3 class="text-xl font-bold">Sample Report Preview</h3>
              </div>
              <div class="w-10 h-10 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center text-accent">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
            </div>

            <!-- PDF Mockup Visual -->
            <div class="relative aspect-[3/4] bg-background border border-border rounded-lg shadow-2xl overflow-hidden mb-8 group-hover:border-accent/30 transition-all">
              <!-- Grid background for document feel -->
              <div class="absolute inset-0 opacity-5 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:20px_20px]"></div>
              
              <div class="p-8 h-full flex flex-col">
                <!-- Report Header Mockup -->
                <div class="flex justify-between items-start mb-12">
                  <div class="space-y-1">
                    <div class="w-20 h-2 bg-accent/20 rounded"></div>
                    <div class="w-12 h-1 bg-accent/10 rounded"></div>
                  </div>
                  <div class="w-8 h-8 rounded bg-accent/5 border border-accent/20"></div>
                </div>

                <!-- Report Content Simulation -->
                <div class="flex-1 space-y-6">
                  <div class="space-y-3">
                    <div class="w-full h-4 bg-muted/20 rounded"></div>
                    <div class="w-3/4 h-3 bg-muted/10 rounded"></div>
                  </div>
                  
                  <div class="p-4 rounded border border-border bg-surface/40 space-y-3">
                    <div class="flex items-center gap-2">
                      <div class="w-2 h-2 rounded-full bg-red-500"></div>
                      <div class="w-24 h-2 bg-red-400/20 rounded"></div>
                    </div>
                    <div class="w-full h-1 bg-muted/10 rounded"></div>
                    <div class="w-full h-1 bg-muted/10 rounded"></div>
                    <div class="w-2/3 h-1 bg-muted/10 rounded"></div>
                  </div>

                  <div class="space-y-2">
                    <div class="w-1/2 h-3 bg-accent/20 rounded"></div>
                    <div class="grid grid-cols-2 gap-4">
                      <div class="aspect-video bg-muted/5 border border-border rounded flex items-center justify-center">
                        <div class="w-1/2 h-1/2 rounded border border-dashed border-accent/20"></div>
                      </div>
                      <div class="aspect-video bg-muted/5 border border-border rounded flex items-center justify-center">
                        <div class="w-1/2 h-1/2 rounded border border-dashed border-accent/20 flex flex-col gap-2 p-2">
                          <div class="w-full h-full bg-accent/5"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Report Footer Mockup -->
                <div class="pt-6 border-t border-border flex justify-between items-center mt-auto">
                   <div class="w-16 h-1.5 bg-muted/20 rounded"></div>
                   <div class="w-6 h-3 bg-accent/10 rounded text-[6px] font-mono flex items-center justify-center text-accent/40">PAGE 01</div>
                </div>
              </div>

              <!-- Overlay Gradient for document top/bottom -->
              <div class="absolute inset-x-0 top-0 h-12 bg-gradient-to-b from-background to-transparent opacity-60"></div>
              <div class="absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-background to-transparent opacity-60"></div>
            </div>

            <!-- Action Buttons -->
            <div class="space-y-4">
              <button class="w-full py-4 rounded-xl bg-accent text-background font-bold flex items-center justify-center gap-3 hover:scale-[1.02] hover:shadow-[0_0_20px_rgba(0,229,255,0.3)] transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Download Sample Report (PDF)
              </button>
              
              <div class="grid grid-cols-2 gap-3">
                <button class="py-3 rounded-xl border border-border bg-surface/50 text-xs font-bold hover:bg-surface transition-all flex items-center justify-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  Interactive View
                </button>
                <button class="py-3 rounded-xl border border-border bg-surface/50 text-xs font-bold hover:bg-surface transition-all flex items-center justify-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                  </svg>
                  Template Details
                </button>
              </div>
            </div>

            <!-- Technical Metadata Footer -->
            <div class="mt-8 pt-6 border-t border-border flex items-center justify-between text-[8px] font-mono text-muted uppercase tracking-widest">
              <span>Template_VER: 4.2.0</span>
              <span>Classification: Confidential</span>
              <span>Format: ISO/IEC 27001 compliant</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
  }
</style>
